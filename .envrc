export FLAKE_ROOT="$(pwd)"

# Jailed agents must not read the real secrets/ submodule, but the flake has to
# evaluate inside the jail, so bind the committed stub from the flake over
# secrets/. agent-toolbox appends JAIL_EXTRA_ARGS to the bwrap call, split on
# whitespace, so the paths below must not contain spaces.
#
# libgit2 refuses a repository owned by another uid; store paths belong to root
# while the jail maps the caller to uid 0, hence the safe.directory config that
# the package ships and that is bound to the jail's ~/.gitconfig (the jail home
# is $FLAKE_ROOT/.home, see agents.persistHome).
stub="$(nix build --no-link --print-out-paths "$FLAKE_ROOT#fake-secrets")" || {
  echo "envrc: could not build the fake secrets stub" >&2
  return 1
}

use flake

# Exported after `use flake` so the dev shell cannot drop it.
export JAIL_EXTRA_ARGS="${JAIL_EXTRA_ARGS:-} --ro-bind $stub/secrets $FLAKE_ROOT/secrets --ro-bind $stub/gitconfig $FLAKE_ROOT/.home/.gitconfig"
